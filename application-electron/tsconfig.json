{
  "extends": ["@tsconfig/strictest", "@tsconfig/node22/tsconfig.json"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "lossless-cut-application": ["../application/src/index.ts"],
      "lossless-cut-application/*": ["../application/src/*"]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*"
  ],
  "references": [
    { "path": "../application" }
  ]
}
