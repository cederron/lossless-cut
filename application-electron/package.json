{
  "name": "lossless-cut-application-electron",
  "private": true,
  "version": "0.0.0",
  "description": "Electron support package for LesslessCut",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./HttpMediaSourceStreamFactory": {
      "types": "./dist/HttpMediaSourceStreamFactory.d.ts",
      "import": "./dist/HttpMediaSourceStreamFactory.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "peerDependencies": {
    "electron": "*"
  },
  "dependencies": {
    "execa": "^9.6.1",
    "lossless-cut-application": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^22.19.3",
    "electron": "38.7.2",
    "rimraf": "^5.0.10",
    "typescript": "~5.9.3"
  },
  "license": "GPL-2.0-only"
}
