{
  "name": "lossless-cut-monorepo",
  "private": true,
  "packageManager": "yarn@4.11.0",
  "workspaces": [
    "electron",
    "electron-stream",
    "backend",
    "application",
    "application-electron",
    "web"
  ],
  "scripts": {
    "dev": "yarn workspace lossless-cut dev",
    "start": "yarn workspace lossless-cut start",
    "dev-stream": "yarn workspace lossless-cut-stream dev",
    "start-stream": "yarn workspace lossless-cut-stream start",
    "build": "yarn workspaces foreach -Atv run build",
    "clean": "yarn workspaces foreach -Atv run clean",
    "tsc": "tsc -b",
    "lint": "yarn workspace lossless-cut lint",
    "test": "yarn workspace lossless-cut test"
  },
  "license": "GPL-2.0-only"
}
