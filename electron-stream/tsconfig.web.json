{
  "extends": ["@tsconfig/strictest", "@tsconfig/vite-react/tsconfig.json"],
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "esnext",
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "types": ["vite/client"],
    "paths": {
      "lossless-cut-application": ["../application/src/index.ts"],
      "lossless-cut-application/*": ["../application/src/*"]
    },
  },
  "references": [
    { "path": "./tsconfig.main.json" },
    { "path": "./tsconfig.common.json" },
    { "path": "../application" },
  ],
  "include": [
    "src/renderer/**/*",
  ],
}